# Generate long random values; never commit the populated .env file.
POSTGRES_PASSWORD=
RD_DATABASE_URL=postgresql+psycopg://rdic:URL_ENCODED_PASSWORD@database:5432/rdic
RD_SECRET_KEY=
# Host port for the app (Caddy). Only this port is used on the server.
RD_PORT=7060
# 127.0.0.1 = reachable only through the server nginx (recommended with a domain).
RD_BIND_ADDRESS=0.0.0.0
# false = direct http://server-ip:7060 access. Set true once HTTPS is in front.
RD_COOKIE_SECURE=false
RD_IMAGE=rdic-crm:1.2.0
RD_RELEASE=1.2.0
RD_REVISION=replace-with-git-commit
RD_SUBSCRIPTION_KEY=
RD_PRIVATE_KEY_PATH=/app/secrets/private_key.pem
RD_PRIVATE_KEY_PASSWORD=
RD_ADMIN_USERNAME=admin
RD_ADMIN_DISPLAY_NAME=Administrator
# TEMPORARY seed password: change it from the Users page after first login.
RD_ADMIN_PASSWORD=admin
